{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "dev:mobile": "vite --mode mobile",
    "build": "tsc -b && vite build --mode web",
    "build:web": "tsc -b && vite build --mode web",
    "build:mobile": "tsc -b && vite build --mode mobile --outDir dist-mobile",
    "cap:sync:android": "npm run build:mobile && npx cap sync android",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:mobile": "vite preview --outDir dist-mobile"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "axios": "^1.18.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
